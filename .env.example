# Progno Environment Variables
# Copy this to .env and fill in your values

# API Keys
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# AWS credentials for NAIP data (or use AWS CLI profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database
PROGNO_DATABASE_URL=postgresql://localhost:5432/progno

# Redis (optional, for caching)
PROGNO_REDIS_URL=redis://localhost:6379

# API Settings
PROGNO_DEBUG=false

# Model Paths (optional, defaults work for development)
# PROGNO_CLASSIFIER_MODEL_PATH=./models/classifier/best_model.pt
# PROGNO_REGRESSION_MODEL_PATH=./models/regression/best_model.pt
