# Container target for Vast.ai GPU training.
# Build with:
#   docker build --platform linux/amd64 -f containers/training/Containerfile -t scenicdriver-training:vast .
# Run through scripts/remote/vast_lifecycle.py with --containerfile containers/training/Containerfile.

ARG TRAINING_IMAGE_PLATFORM=linux/amd64
FROM --platform=${TRAINING_IMAGE_PLATFORM} pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /uvx /usr/local/bin/

ENV PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    SCENIC_S3_ONLY=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/scenic-drive

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY src ./src
COPY scripts ./scripts
COPY notebooks ./notebooks
COPY data/README.md ./data/README.md

CMD ["bash"]
