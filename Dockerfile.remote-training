# Stage 1: Dependency exporter
FROM ghcr.io/astral-sh/uv:0.9.16 AS builder
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --no-emit-project \
      --prune torch --prune torchvision \
      --output-file /tmp/remote-training-requirements.txt

# Stage 2: CUDA runtime
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/conda/bin:/root/.local/bin:${PATH}" \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.16 /uv /uvx /usr/local/bin/
WORKDIR /workspace
COPY --from=builder /tmp/remote-training-requirements.txt /tmp/remote-training-requirements.txt
RUN uv pip install --system --no-cache-dir --no-deps \
      --requirement /tmp/remote-training-requirements.txt \
 && rm /tmp/remote-training-requirements.txt
COPY pyproject.toml uv.lock ./
COPY src/ src/
COPY scripts/ scripts/
COPY notebooks/ notebooks/
COPY config/ config/
COPY data/README.md data/README.md
COPY README.md AGENTS.md ./
RUN uv pip install --system --no-cache-dir --no-deps -e .
RUN mkdir -p data/raw data/processed models cache scenic_artifacts
# The image intentionally has no runtime command; callers select a canonical
# lifecycle or benchmark entrypoint explicitly.
