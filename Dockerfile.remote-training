# pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/opt/conda/bin:/root/.local/bin:${PATH}"
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC


RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned uv binary image; avoids the curl installer path.
COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# Install project dependencies into the CUDA-enabled base environment.
# Torch and torchvision come from the PyTorch CUDA image; do not replace them
# with locked PyPI wheels during image build.
COPY pyproject.toml uv.lock ./
RUN uv pip install --system --no-cache-dir \
    "numpy>=1.26,<2" \
    "pandas>=2.2" \
    "pillow>=10.0" \
    "marimo>=0.19.7" \
    "fastapi>=0.115" \
    "uvicorn>=0.30" \
    "boto3>=1.34" \
    "requests>=2.31" \
    "tqdm>=4.66" \
    "huggingface-hub>=0.34" \
    "safetensors>=0.4" \
    "pyyaml>=6"
RUN uv pip install --system --no-cache-dir --no-deps "timm>=1.0.24"

# Copy application source (training-only; no apps/)
COPY src/ src/
COPY scripts/ scripts/
COPY notebooks/ notebooks/
COPY config/ config/
COPY data/README.md data/README.md
COPY README.md AGENTS.md ./

# Install the local package metadata without re-resolving torch/torchvision.
RUN uv pip install --system --no-cache-dir --no-deps -e .

# Create runtime directories
RUN mkdir -p data/raw data/processed models cache scenic_artifacts

CMD ["python", "scripts/remote/container_smoke.py"]
