FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Use a pinned uv binary rather than an unpinned installer download.
COPY --from=ghcr.io/astral-sh/uv:0.9.16 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY src/ src/
COPY config/ config/
COPY scripts/routing/check_beta_artifacts.py scripts/routing/check_beta_artifacts.py

CMD ["sh", "-c", "uv run python scripts/routing/check_beta_artifacts.py && exec uv run uvicorn src.app_api.main:app --host 0.0.0.0 --port 8080"]
