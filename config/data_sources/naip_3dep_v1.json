    "catalog_sha256": null,
    "catalog_format": "naip_visualization_normalized",
    "discovery_prefixes": ["ct/", "dc/", "de/", "ma/", "md/", "me/", "mi/", "nh/", "nj/", "ny/", "oh/", "pa/", "ri/", "va/", "vt/", "wv/"],
    "manifest_key": "manifest.txt",
    "manifest_bytes_upper_bound": 268435456,
    "download_mode": "whole_object",
    "estimates": {
      "per_asset_requests": 2,
