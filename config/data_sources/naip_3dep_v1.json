{
  "schema_version": 1,
  "contract_id": "naip_3dep_v1",
  "description": "Open-data acquisition contract: USDA NAIP naip-visualization 3-band RGB COG imagery plus USGS 3DEP 1/3 arc-second seamless elevation, both rendered onto an exact Web Mercator z14 512x512 grid. Deterministic, fail-closed, requester-pays-aware. No Mapbox and no unknown billable provider is admissible under this contract.",
  "imagery": {
    "provider": "usda_naip",
    "collection": "naip-visualization",
    "style": "satellite",
    "bucket": "naip-visualization",
    "region": "us-west-2",
    "requester_pays": true,
    "allowed_states": ["ct", "dc", "de", "ma", "md", "me", "mi", "nh", "nj", "ny", "oh", "pa", "ri", "va", "vt", "wv"],
    "license": "Public Domain with Attribution",
