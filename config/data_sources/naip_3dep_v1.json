      "per_asset_requests": 2,
      "per_asset_bytes_upper_bound": 268435456,
      "per_tile_output_bytes_upper_bound": 1048576
    }
  },
  "preprocessing": {
    "contract_id": "naip_3dep_v1.preprocess.1",
    "target_crs": "EPSG:3857",
    "zoom": 14,
    "tile_width": 512,
    "tile_height": 512,
    "satellite_resampling": "cubic",
    "terrain_resampling": "bilinear",
    "terrain_rgb_version": "terrain-rgb-v1",
    "terrain_rgb_formula": "h = -10000.0 + 0.1 * (R * 65536 + G * 256 + B); q = floor((h + 10000.0) * 10.0 + 0.5) in float64; R=(q>>16)&255, G=(q>>8)&255, B=q&255",
    "terrain_round_trip_tolerance_m": 0.0500001,
    "target_vertical_datum": "NAVD88",
    "target_vertical_crs": "EPSG:5703",
    "vertical_transform_grid": null,
    "outside_land_elevation": -10000.0,
    "satellite_fill": [0, 0, 0],
    "mosaic_order": "first",
    "nodata_policy": "zero no-data pixels allowed on land; outside-land fill only after masking",
    "output_format": "deterministic 8-bit RGB PNG, exactly 512x512, no alpha",
    "tile_asset_rule": {
      "naip_vintage_selection": "per tile, intersect chosen-state assets with positive-area footprint intersection; keep only assets of the maximum acquisition year present (single-vintage preference); order follows the adapter's declared ordering (year desc, capture date desc, resolution asc, canonical uri)",
      "state_selection": "argmax over allowed states of the maximum positive-area bbox intersection of that state's catalog assets with the tile bounds; ties resolve lexicographically by state code",
      "3dep_selection": "all catalog records whose footprint bbox intersects the tile bounds, ordered by (asset_id, canonical_uri)"
    },
    "satellite_qc": {
      "reject_all_black": true,
      "reject_all_white": true,
      "min_land_variance": 1.0
    }
  },
  "boundaries": {
    "provider": "us_census_bureau",
    "collection": "tigerweb_2025_state_county",
    "provider_url": "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/State_County/MapServer/0/query",
    "access_date": "2026-08-10"
  },
  "rate_card": {
