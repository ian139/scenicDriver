    "style": "terrain",
    "bucket": "prd-tnm",
    "region": null,
    "requester_pays": false,
    "license": "Public Domain",
    "attribution": "USGS 3D Elevation Program",
    "provider_url": "https://www.usgs.gov/3d-elevation-program",
    "access_date": "2026-08-10",
    "catalog_snapshot": "data/raw/sources/naip_3dep_v1/catalog/usgs_3dep_13as_catalog.json",
    "catalog_sha256": null,
    "catalog_format": "usgs_3dep_13as_records",
    "discovery_prefixes": ["StagedProducts/Elevation/13/TIFF/current/"],
    "catalog_max_objects": 50000,
    "catalog_page_size": 1000,
    "page_response_bytes_upper_bound": 1048576,
    "companion_metadata_bytes_upper_bound": 1048576,
